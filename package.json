{
  "version": "0.0.0",
  "private": true,
  "name": "angular-phonecat",
  "description": "A tutorial application for AngularJS",
  "repository": "https://github.com/angular/angular-phonecat",
  "license": "MIT",
  "devDependencies": {
    "bower": "^1.8.14",
    "grunt": "^1.6.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-copy-force": "^1.0.1",
    "grunt-contrib-cssmin": "^4.0.0",
    "grunt-contrib-uglify": "^3.4.0",
    "grunt-contrib-uglify-es": "^3.3.0",
    "grunt-filerev": "^2.3.1",
    "grunt-rev": "^0.1.0",
    "grunt-terser": "^2.0.0",
    "grunt-usemin": "^3.1.1",
    "grunt-version-assets": "^1.1.0",
    "http-server": "^14.1.0",
    "lite-server": "^2.6.1",
    "shelljs": "^0.8.5",
    "tmp": "0.0.23"
  },
  "scripts": {
    "postinstall": "bower install",
    "prestart": "npm install",
    "start": "lite-server",
    "pretest": "npm install",
    "test": "node node_modules/karma/bin/karma start test/karma.conf.js",
    "test-single-run": "node node_modules/karma/bin/karma start test/karma.conf.js  --single-run",
    "preupdate-webdriver": "npm install",
    "update-webdriver": "webdriver-manager update",
    "preprotractor": "npm run update-webdriver",
    "protractor": "protractor test/protractor-conf.js",
    "update-index-async": "node -e \"require('shelljs/global'); sed('-i', /\\/\\/@@NG_LOADER_START@@[\\s\\S]*\\/\\/@@NG_LOADER_END@@/, '//@@NG_LOADER_START@@\\n' + cat('bower_components/angular-loader/angular-loader.min.js') + '\\n//@@NG_LOADER_END@@', 'app/index-async.html');\""
  },
  "dependencies": {
    "angularjs-fusioncharts": "^5.0.3",
    "fullcalendar-scheduler": "^5.11.2",
    "fusioncharts": "^3.19.0",
    "grunt-contrib-watch": "^1.0.0",
    "pdfmake": "^0.1.38",
    "scanbot-web-sdk": "^2.11.0",
    "uglify-js": "^3.4.9",
    "ag-grid-enterprise": "34.0.2",
    "ag-charts-enterprise": "12.0.2"
  },
  "lite-server": {
    "server": {
      "baseDir": "./app",
      "routes": {
        "/bower_components": "./bower_components"
      }
    },
    "files": [ "./app/**/*.{html,htm,css,js}" ]
  }

}
